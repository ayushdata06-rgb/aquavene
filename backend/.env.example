# =============================================================
# AquaVane Backend Configuration
# Copy this file to .env and fill in your values
# =============================================================

# --- Database (Supabase PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+psycopg://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Direct connection (for migrations)
DATABASE_URL_DIRECT=postgresql+psycopg://postgres.xxxx:password@db.xxxx.supabase.co:5432/postgres

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# NEVER expose the service role key to the frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Application ---
APP_NAME=AquaVane
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage ---
# Path to local data directory for rasters and processing
DATA_DIR=./data
# Supabase Storage bucket for large raster files (optional)
SUPABASE_STORAGE_BUCKET=aquavane-rasters

# --- WhiteboxTools ---
# Path to the WhiteboxTools executable
WHITEBOX_EXE_PATH=whitebox_tools
# Working directory for WhiteboxTools temporary files
WHITEBOX_WORK_DIR=./data/interim/whitebox

# --- Processing ---
# Max upload file size in MB
MAX_UPLOAD_SIZE_MB=500
# Processing job timeout in seconds
PROCESSING_TIMEOUT_SECONDS=3600

# --- Auth ---
# Set to true to enable JWT authentication
AUTH_ENABLED=false
# JWT secret (from Supabase project settings -> API -> JWT Secret)
JWT_SECRET=your-supabase-jwt-secret
JWT_ALGORITHM=HS256
